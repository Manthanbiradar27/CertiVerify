{
  "name": "certiverify-server",
  "version": "1.0.0",
  "description": "CertiVerify backend API — secure digital certificate verification platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit --detectOpenHandles",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage --forceExit --detectOpenHandles",
    "create-admin": "node scripts/createAdmin.js",
    "seed-demo": "node scripts/seedDemo.js"
  },
  "keywords": ["certificate", "verification", "mern"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "testTimeout": 30000
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "nanoid": "^3.3.20",
    "nodemailer": "^10.0.16",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
